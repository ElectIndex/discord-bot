# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# ElectIndex server ID (right-click server -> Copy Server ID). If set, the bot leaves any other server.
GUILD_ID=

# --- Members-only gate (cogs/membership.py). The gate stays OFF unless EI_API_SECRET and GATE_SINCE are set.
# Shared secret; must match ELECTINDEX_DISCORD_API_SECRET in the site's wp-config.php.
EI_API_SECRET=
# Defaults to https://electindex.com/wp-json/electindex/v1/discord/members
EI_API_URL=
# Members who joined at or before this moment are grandfathered and never removed (ISO 8601, UTC).
GATE_SINCE=
# Comma-separated role ids that are never removed (staff). Administrators are always exempt.
STAFF_ROLE_IDS=

# --- #polpollsnews (cogs/polpollsnews.py): NYT poll cards -> staff ✅ -> @polpollsnews on X.
# Off unless the channel id is set.
POLPOLLSNEWS_CHANNEL_ID=
# Extra approver roles (default: STAFF_ROLE_IDS). Admins and Manage Messages always can.
POLL_APPROVER_ROLE_IDS=
# @polpollsnews X app, OAuth 2.0 (developer.x.com -> app -> Keys and tokens -> OAuth 2.0
# Client ID and Client Secret). App type "Web App, Automated App or Bot", permissions Read and
# Write, callback URI http://127.0.0.1:8765/callback. Then an admin runs /xlogin in Discord.
POLPOLLSNEWS_X_CLIENT_ID=
POLPOLLSNEWS_X_CLIENT_SECRET=
# Accounts whose quotes of @polpollsnews posts get liked and reposted (comma-separated).
POLPOLLSNEWS_QUOTE_WATCH=davidslosttt
# true = an approved card really tweets. Anything else is a dry run.
POLPOLLSNEWS_TWEETS_ENABLED=false
# /poll reads links, text, screenshots and PDFs with Claude (platform.claude.com -> API keys).
ANTHROPIC_API_KEY=
# Only for a key not scoped to a workspace (Console -> Settings -> Workspaces, wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
